// Planck's Law Derivation (Equations Only with $  $)

$ E_n = n h nu quad "with" quad n = 0, 1, 2, dots $

$ lr(chevron.l E chevron.r) = frac(sum_(n=0)^oo E_n e^(-E_n / (k_B T)), sum_(n=0)^oo e^(-E_n / (k_B T))) $

$ lr(chevron.l E chevron.r) = frac(sum_(n=0)^oo n h nu e^(-n h nu / (k_B T)), sum_(n=0)^oo e^(-n h nu / (k_B T))) $

$ lr(chevron.l E chevron.r) = frac(h nu, e^(h nu / (k_B T)) - 1) $

$ u(nu, T) = frac(8 pi nu^2, c^3) lr(chevron.l E chevron.r) $

$ u(nu, T) = frac(8 pi h nu^3, c^3) dot frac(1, e^(h nu / (k_B T)) - 1) $

$ u(lambda, T) = frac(8 pi h c, lambda^5) dot frac(1, e^(h c / (lambda k_B T)) - 1) $


